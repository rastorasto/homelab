# OmniRoute — AI gateway in front of litellm (ai.mnau.org), exposed as omni.mnau.org.
# Copy to .env (chmod 600) and fill.
# Generate secrets:  JWT_SECRET=$(openssl rand -base64 48)
#                    API_KEY_SECRET=$(openssl rand -hex 32)
#                    INITIAL_PASSWORD=$(openssl rand -base64 16)
#                    OMNIROUTE_WS_BRIDGE_SECRET=$(openssl rand -base64 32)

# --- generated per-install secrets ---
JWT_SECRET=
API_KEY_SECRET=
INITIAL_PASSWORD=          # dashboard admin login (admin / this)
OMNIROUTE_WS_BRIDGE_SECRET=

# --- shared with client configs; decrypts stored provider creds ---
STORAGE_ENCRYPTION_KEY=
OMNIROUTE_API_KEY=         # client key for /v1/* (Claude Code, curl, ...)

DATA_DIR=/data
REQUIRE_API_KEY=true
AUTH_COOKIE_SECURE=true                  # served over HTTPS via caddy
OMNIROUTE_ALLOW_PRIVATE_PROVIDER_URLS=true   # upstream is http://litellm:4000 (docker net)
CONTAINER_HOST=docker
OMNIROUTE_ENABLE_LIVE_WS=0               # single caddy port serves dashboard+api
