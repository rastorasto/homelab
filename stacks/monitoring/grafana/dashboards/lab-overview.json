{
  "uid": "lab-overview",
  "title": "Lab overview",
  "tags": ["lab"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-6h", "to": "now"},
  "editable": true,
  "graphTooltip": 0,
  "templating": {"list": []},
  "annotations": {"list": []},
  "links": [],
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "liveNow": false,
  "panels": [
    {"type": "row", "id": 100, "title": "Nodes", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}, "collapsed": false, "panels": []},

    {"id": 10, "type": "timeseries", "title": "CPU used %, per node", "datasource": {"type": "prometheus"},
     "gridPos": {"x": 0, "y": 1, "w": 8, "h": 8},
     "targets": [{"expr": "1 - avg by (job) (rate(node_cpu_seconds_total{mode=\"idle\",job=~\"node-.+\"}[5m]))", "legendFormat": "{{job}}", "format": "time_series"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 18, "showPoints": "never", "spanNulls": false}}},
     "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 11, "type": "timeseries", "title": "RAM used %, per node", "datasource": {"type": "prometheus"},
     "gridPos": {"x": 8, "y": 1, "w": 8, "h": 8},
     "targets": [{"expr": "1 - node_memory_MemAvailable_bytes{job=~\"node-.+\"} / node_memory_MemTotal_bytes{job=~\"node-.+\"}", "legendFormat": "{{job}}", "format": "time_series"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 18, "showPoints": "never", "spanNulls": false}}},
     "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 12, "type": "timeseries", "title": "Disk used %: / and /mnt/data", "datasource": {"type": "prometheus"},
     "gridPos": {"x": 16, "y": 1, "w": 8, "h": 8},
     "targets": [{"expr": "1 - node_filesystem_avail_bytes{job=~\"node-.+\",mountpoint=~\"^/$|^/mnt/data$\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=~\"node-.+\",mountpoint=~\"^/$|^/mnt/data$\",fstype!~\"tmpfs|overlay\"}", "legendFormat": "{{job}} {{mountpoint}}", "format": "time_series"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 18, "showPoints": "never", "spanNulls": false}}},
     "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},

    {"type": "row", "id": 101, "title": "Containers", "gridPos": {"x": 0, "y": 9, "w": 24, "h": 1}, "collapsed": false, "panels": []},

    {"id": 20, "type": "timeseries", "title": "Top 10 containers by CPU %", "datasource": {"type": "prometheus"},
     "gridPos": {"x": 0, "y": 10, "w": 12, "h": 9},
     "targets": [{"expr": "topk(10, sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m])) * 100)", "legendFormat": "{{name}}", "format": "time_series"}],
     "fieldConfig": {"defaults": {"unit": "percent", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false}}},
     "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 21, "type": "timeseries", "title": "Top 10 containers by memory", "datasource": {"type": "prometheus"},
     "gridPos": {"x": 12, "y": 10, "w": 12, "h": 9},
     "targets": [{"expr": "topk(10, container_memory_usage_bytes{name!=\"\"})", "legendFormat": "{{name}}", "format": "time_series"}],
     "fieldConfig": {"defaults": {"unit": "decbytes", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false}}},
     "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},

    {"type": "row", "id": 102, "title": "Backup & network", "gridPos": {"x": 0, "y": 19, "w": 24, "h": 1}, "collapsed": false, "panels": []},

    {"id": 30, "type": "stat", "title": "Backup age", "datasource": {"type": "prometheus"},
     "gridPos": {"x": 0, "y": 20, "w": 6, "h": 4},
     "targets": [{"expr": "time() - restic_backup_last_success_timestamp", "format": "time_series"}],
     "fieldConfig": {"defaults": {"unit": "dtdurations", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 129600}]}, "color": {"mode": "thresholds"}},
      "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value", "orientation": "auto", "justifyMode": "auto", "showPercentChange": false}},
    {"id": 31, "type": "stat", "title": "Repo snapshots", "datasource": {"type": "prometheus"},
     "gridPos": {"x": 6, "y": 20, "w": 6, "h": 4},
     "targets": [{"expr": "restic_backup_snapshots_total", "format": "time_series"}],
     "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 3}]}, "color": {"mode": "thresholds"}},
      "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "area", "textMode": "value", "orientation": "auto", "justifyMode": "auto", "showPercentChange": false}},
    {"id": 34, "type": "stat", "title": "TLS cert days left (min)", "datasource": {"type": "prometheus"},
     "gridPos": {"x": 12, "y": 20, "w": 6, "h": 4},
     "targets": [{"expr": "min(probe_ssl_earliest_cert_expiry{job=\"blackbox-http\"} - time()) / 86400", "format": "time_series"}],
     "fieldConfig": {"defaults": {"unit": "d", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 21}, {"color": "green", "value": 35}]}, "color": {"mode": "thresholds"}},
      "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value", "orientation": "auto", "justifyMode": "auto", "showPercentChange": false}},
    {"id": 35, "type": "timeseries", "title": "Network rx (bit/s)", "datasource": {"type": "prometheus"},
     "gridPos": {"x": 0, "y": 24, "w": 12, "h": 6},
     "targets": [{"expr": "8 * rate(node_network_receive_bytes_total{job=~\"node-.+\",device!~\"lo|docker.*|veth.*|tailscale.*\"}[5m])", "legendFormat": "{{job}} {{device}}", "format": "time_series"}],
     "fieldConfig": {"defaults": {"unit": "bps", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 15, "showPoints": "never", "spanNulls": false}}},
     "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},
    {"id": 36, "type": "timeseries", "title": "Network tx (bit/s)", "datasource": {"type": "prometheus"},
     "gridPos": {"x": 12, "y": 24, "w": 12, "h": 6},
     "targets": [{"expr": "8 * rate(node_network_transmit_bytes_total{job=~\"node-.+\",device!~\"lo|docker.*|veth.*|tailscale.*\"}[5m])", "legendFormat": "{{job}} {{device}}", "format": "time_series"}],
     "fieldConfig": {"defaults": {"unit": "bps", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 15, "showPoints": "never", "spanNulls": false}}},
     "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},

    {"type": "row", "id": 103, "title": "Public & security (VPS)", "gridPos": {"x": 0, "y": 30, "w": 24, "h": 1}, "collapsed": false, "panels": []},

    {"id": 40, "type": "stat", "title": "fail2ban banned IPs by jail", "datasource": {"type": "prometheus"},
     "gridPos": {"x": 0, "y": 31, "w": 4, "h": 4},
     "targets": [{"expr": "fail2ban_jail_banned_ips", "legendFormat": "{{jail}}", "format": "time_series"}],
     "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 100}, {"color": "red", "value": 500}]}, "color": {"mode": "thresholds"}}, "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "none", "graphMode": "none", "textMode": "value_and_name", "orientation": "vertical", "justifyMode": "center", "showPercentChange": false}},

    {"id": 41, "type": "stat", "title": "crowdsec total bans", "datasource": {"type": "prometheus"},
     "gridPos": {"x": 4, "y": 31, "w": 4, "h": 4},
     "targets": [{"expr": "sum(cs_active_decisions)", "format": "time_series"}],
     "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 500}, {"color": "red", "value": 5000}]}, "color": {"mode": "thresholds"}}, "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "area", "textMode": "value", "orientation": "auto", "justifyMode": "auto", "showPercentChange": false}},

    {"id": 45, "type": "bargauge", "title": "top ban reasons", "datasource": {"type": "prometheus"},
     "gridPos": {"x": 0, "y": 35, "w": 8, "h": 8},
     "targets": [{"expr": "topk(8, sum by (reason) (cs_active_decisions{action=\"ban\"}))", "legendFormat": "{{reason}}", "format": "time_series", "instant": true}],
     "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "orange", "value": null}]}}, "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true, "text": {"titleSize": 10}}},

    {"id": 42, "type": "timeseries", "title": "Public HTTP requests/s by status (traefik)", "datasource": {"type": "prometheus"},
     "gridPos": {"x": 8, "y": 31, "w": 16, "h": 8},
     "targets": [{"expr": "sum by (code) (rate(traefik_entrypoint_requests_total[5m]))", "legendFormat": "{{code}}", "format": "time_series"}],
     "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "spanNulls": false}}},
     "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},

    {"id": 43, "type": "timeseries", "title": "fail2ban failed logins, by jail (total)", "datasource": {"type": "prometheus"},
     "gridPos": {"x": 8, "y": 39, "w": 8, "h": 4},
     "targets": [{"expr": "fail2ban_jail_failed_attempts_total", "legendFormat": "{{jail}}", "format": "time_series"}],
     "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "showPoints": "never"}}},
     "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}},

    {"id": 44, "type": "timeseries", "title": "crowdsec lines parsed/s", "datasource": {"type": "prometheus"},
     "gridPos": {"x": 16, "y": 39, "w": 8, "h": 4},
     "targets": [{"expr": "rate(cs_parser_hits_total[5m])", "legendFormat": "{{source}}", "format": "time_series"}],
     "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "showPoints": "never"}}},
     "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}}
  ]
}
