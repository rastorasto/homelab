     "targets": [{"expr": "1 - node_filesystem_avail_bytes{job=\"node-vps\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"node-vps\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}", "format": "time_series"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.8}, {"color": "red", "value": 0.9}]}, "color": {"mode": "thresholds"}},
