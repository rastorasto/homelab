    {"id": 8, "type": "stat", "title": "meow-pve · disk /", "datasource": {"type": "prometheus"},
     "gridPos": {"x": 8, "y": 9, "w": 8, "h": 4},
     "targets": [{"expr": "1 - node_filesystem_avail_bytes{job=\"node-pve\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"node-pve\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}", "format": "time_series"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.8}, {"color": "red", "value": 0.9}]}, "color": {"mode": "thresholds"}},
