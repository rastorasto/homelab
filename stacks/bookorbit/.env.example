# Copy to .env (chmod 600) and fill in. Generate secrets with:
#   openssl rand -hex 24   # POSTGRES_PASSWORD
#   openssl rand -hex 32   # JWT_SECRET
#   openssl rand -hex 16   # SETUP_BOOTSTRAP_TOKEN
APP_IMAGE=ghcr.io/bookorbit/bookorbit:latest
APP_URL=https://books.mnau.org

POSTGRES_USER=bookorbit
POSTGRES_PASSWORD=
POSTGRES_DB=bookorbit

JWT_SECRET=
SETUP_BOOTSTRAP_TOKEN=

# Node.js heap limit in MB. Keep in step with the 1G container limit in compose.yml.
NODE_MAX_OLD_SPACE_SIZE=768

TZ=Europe/Bratislava
PUID=1000
PGID=1000

# --- Optional (see https://bookorbit.app/installation#configuration) ---
# LOG_LEVEL=info
# LIBRARY_BROWSE_ROOT=/books
# EMAIL_ENCRYPTION_KEY=
# MIGRATION_ENCRYPTION_KEY=
